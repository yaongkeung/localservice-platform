{
  "name": "localservice-platform-production",
  "account_id": "SET_ACTUAL_ACCOUNT_ID",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {"APP_ENV": "production", "SEARCH_INDEXING": "disabled", "NAVER_SITE_VERIFICATION": "SET_ACTUAL_VERIFICATION_VALUE"},
  "ai": {"binding": "AI"},
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "localservice-platform-production-db", "database_id": "SET_NEW_PRODUCTION_D1_ID", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "PHOTOS", "bucket_name": "localservice-platform-production-photos"}]
}
