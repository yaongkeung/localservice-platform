{
  "name": "localservice-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:search": "node scripts/search-audit.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node --test test/*.test.js",
    "check": "node --check src/worker.js && node --check src/cms.js && node --check src/auth.js",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:create:staging": "node scripts/create-staging-admin.mjs",
    "build:check": "wrangler deploy --dry-run --outdir .local/worker-build",
    "test:runtime": "node scripts/runtime-check.mjs",
    "admin:recover": "node scripts/recover-admin.mjs",
    "deploy:check": "node scripts/deploy-check.mjs",
    "backup:local": "node scripts/backups.mjs create",
    "backup:verify": "node scripts/backups.mjs verify",
    "backup:restore": "node scripts/backups.mjs restore"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "jpeg-js": "0.4.4"
  },
  "devDependencies": {
    "miniflare": "5.20261113.0-beta",
    "wrangler": "4.162.0"
  }
}
